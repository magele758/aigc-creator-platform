  },
  "google": {
    "label": "Google Gemini Image",
    "kinds": ["image", "edit"],
    "keys": ["STUDIO_GEMINI_IMAGE_KEY"],
    "model": "gemini-nano-banana-2.1",
    "modelEnv": "STUDIO_GEMINI_IMAGE_MODEL"
  },
  "aliyun": {
    "label": "阿里云百炼 · 千问图像",
    "kinds": ["image", "edit"],
    "keys": ["STUDIO_DASHSCOPE_IMAGE_KEY", "STUDIO_DASHSCOPE_ORIGIN"],
    "model": "qwen-image-3.0-pro",
    "modelEnv": "STUDIO_DASHSCOPE_IMAGE_MODEL"
  },
  "jimeng": {
    "label": "即梦企业视觉 · 文生图",
